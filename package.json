{
  "name": "breastcalculator",
  "version": "1.0.0",
  "private": true,
  "description": "Breast Calculator — static site deployed to Cloudflare Workers.",
  "scripts": {
    "build": "node scripts/build-tailwind.js && node scripts/purgecss.js && node scripts/build-css.js && node scripts/split-script.js && node scripts/reflow-fix.js && node scripts/idle-schedule.js && node scripts/dom-reduce.js && node scripts/layout-normalize.js && node scripts/perf-fixes.js && node scripts/build-dist.js && node scripts/optimize.js && node scripts/cache-bust.js && echo 'Static site ready in dist/.'",
    "reflow-fix": "node scripts/reflow-fix.js",
    "idle-schedule": "node scripts/idle-schedule.js",
    "dom-reduce": "node scripts/dom-reduce.js",
    "layout-normalize": "node scripts/layout-normalize.js",
    "dev": "echo 'Open index.html in a browser, or run: npx http-server -p 8000'",
    "optimize": "node scripts/optimize.js",
    "tailwind": "node scripts/build-tailwind.js",
    "purge": "node scripts/purgecss.js",
    "purge:verify": "node scripts/verify-purge.js",
    "cache-bust": "node scripts/cache-bust.js",
    "build:dist": "node scripts/build-dist.js",
    "inject:ga4": "node scripts/inject-ga4.js",
    "inject:ga4:check": "node scripts/inject-ga4.js --check",
    "inject:adsense": "node scripts/inject-adsense.js",
    "inject:adsense:check": "node scripts/inject-adsense.js --check",
    "inject:adsense:upgrade": "node scripts/inject-adsense.js --upgrade",
    "indexnow": "node scripts/indexnow.js changed",
    "indexnow:submit": "node scripts/indexnow.js submit",
    "indexnow:force": "node scripts/indexnow.js submit --force",
    "indexnow:verify": "node scripts/indexnow.js verify",
    "indexnow:deleted": "node scripts/indexnow.js --deleted",
    "indexnow:delta": "node scripts/indexnow.js delta",
    "indexnow:coverage": "node scripts/indexnow.js coverage",
    "indexnow:mark": "node scripts/indexnow.js mark",
    "seo:hreflang": "python scripts/seo/hreflang_audit.py",
    "seo:hreflang:fast": "python scripts/seo/hreflang_audit.py --no-http",
    "seo:hreflang:fix": "python scripts/seo/fix_hreflang.py",
    "seo:hreflang:fix:dry": "python scripts/seo/fix_hreflang.py --dry-run",
    "seo:sitemap:dry": "python scripts/seo/sitemap_cleaner.py --dry-run",
    "seo:sitemap:fix": "python scripts/seo/sitemap_cleaner.py",
    "seo:sitemap:inplace": "python scripts/seo/sitemap_cleaner.py --in-place",
    "seo:deadlinks": "python scripts/seo/fix_dead_links.py --report reports/ahrefs_links_report.csv",
    "sitemap": "node scripts/generate-sitemap.js",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "deploy:clean": "npm run build && wrangler deploy --clean"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "static-site",
    "cloudflare-workers"
  ],
  "devDependencies": {
    "acorn": "^8.17.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.99.0"
  }
}
