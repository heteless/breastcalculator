# IDE & tool state
.agents/
.trae/
.reasonix/
.cursor/
.aider*
.windsurf/

# Local dev-server output
.next-dev-server/
.next/
.nuxt/
.cache/

# Test output & one-off files
test-output.html
test-output.txt
test-output.*
_*.cjs
72df502a4b3a4fcbb6662b9eedd24912.txt
# any random hex-named tmp file
[a-f0-9]{16,}.txt

# Backup / temp / fragment files
*.bak
*.tmp
*.orig
*.rej
*.swp
_tmp.*
temp_*
~*

# Root-level dev scripts & template fragments
# (production assets live under /assets/ and /common.js)
# NOTE: script.js is intentionally tracked — it is the source that
# scripts/split-script.js reads to generate common.js + calculator.js
# during the Cloudflare build. Without it, `npm run build` fails with
# ENOENT in CI. It is excluded from dist/ via EXCLUDE_FILES in
# scripts/build-dist.js, so it never ships to production.
dev-server.js
calculator.js
footer.html
header-wellness-popup.html
skills-lock.json

# Tailwind dev sources (production CSS lives in /main.css and /assets/*.css)
# Tracked so Cloudflare Pages can run `npm run build` and regenerate the
# dist/ tree on the edge. If you don't want Cloudflare to rebuild, change
# the Pages build command to `true` and rely on the committed dist/ instead.
!tailwind-input.css
!tailwind.config.js
!tailwind-built.css
# PurgeCSS dev config
!purgecss.config.cjs

# Sitemap XML used only by the dev SEO tooling
# (Cloudflare Pages reads /sitemap.xml from the repo root in production)
# keep this commented if you want sitemap.xml tracked
# sitemap.xml

# === Dev script directory (build / test / generate / inject) ===
# Production build is fully static. We allow a minimal allowlist of
# build scripts so Cloudflare Pages can run `npm run build` and
# regenerate dist/ on the edge. Everything else stays untracked.
#
# Implementation: re-include the whole `scripts/` dir, then ignore
# everything except the allowlist. This is more reliable than
# `scripts/ + !scripts/foo.js` which still matches via the directory.
!scripts/
/scripts/*
# --- Allowlist: scripts required by `npm run build` ---
!/scripts/build-tailwind.js
!/scripts/purgecss.js
!/scripts/build-css.js
!/scripts/split-script.js
!/scripts/reflow-fix.js
!/scripts/idle-schedule.js
!/scripts/dom-reduce.js
!/scripts/layout-normalize.js
!/scripts/perf-fixes.js
!/scripts/build-dist.js
!/scripts/optimize.js
!/scripts/cache-bust.js
!/scripts/articles-data.js
# --- Allowlist: scripts required by GitHub Actions workflows ---
!/scripts/generate-sitemap.js

# === .well-known split ===
# Production files: keep llms.txt, security.txt, api-catalog
# Dev-only agent skills live under .well-known/agent-skills/
.well-known/agent-skills/
.well-known/dns-aid/
.well-known/link-headers/
.well-known/markdown-negotiation/
.well-known/api-catalog.json

# === Root-level config & docs not needed for production ===
# Cloudflare config: KEEP wrangler.toml and _headers / _redirects
# Other config: dev-only
.husky/
.lintstagedrc*
.commitlint*
.editorconfig
.prettierrc*
.eslintrc*
