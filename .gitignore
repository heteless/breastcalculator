# === IDE / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# === 临时文件 ===
__pycache__/
*.pyc
*.pyo
build.log

# === Node (Cloudflare Pages build shim) ===
# package.json is committed so `npm install && npm run build` succeeds
# in the Cloudflare Pages build environment. The artifacts below are
# not part of the site and should not be tracked.
node_modules/
package-lock.json

# === Wrangler ===
.wrangler-out/
.wrangler/

# === Build output (Cloudflare Workers assets directory) ===
# dist/ MUST be tracked so Cloudflare Pages (which clones the repo and
# cannot run our local `npm run build` because scripts/ is excluded) can
# serve the latest build. We commit the generated `dist/` and never edit
# it by hand. If you need to rebuild: `node scripts/build-dist.js`.
dist/
!dist/
dist-dryrun/

# === Audit / log / debug output from scripts/ ===
.audit*.log
.tree.log
.file-tree.txt
.seo-audit.csv
.seo-tags-audit.txt
.internal-links-audit.csv

# === Local generation cache used by hub builders ===
.tmp-gen/
.tmp-*.log
.tmp-*.html
.tmp-*

# === IndexNow state ===
.indexnow-key
.indexnow-hashes.json
.indexnow-sitemap-prev.json
bing_index_status.json

# === SEO audit scripts (scripts/seo/) ===
reports/
.backup/
sitemap_fixed.xml
sitemap.xml.bak
.tmp-sitemap.xml

# ============================================================
