# Wrangler ignore file - gitignore-style syntax.
# Files matched here are NOT uploaded during `wrangler deploy`.
# This is what keeps the 119 MiB `node_modules/workerd/bin/workerd`
# binary out of the asset bundle so we stay under the 25 MiB limit.

# === Node.js dependencies (the 119 MiB workerd binary lives here) ===
node_modules/

# === Build-time scripts (run during `npm run build`, not part of the site) ===
scripts/

# === Version control ===
.git/
.gitignore
.gitattributes

# === Wrangler config files (don't expose on the public site) ===
.wrangler/
.wranglerignore
wrangler.jsonc

# === Logs and temporary files ===
*.log
build.log

# === IDE / OS junk ===
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# === Build / cache outputs (none today, future-proofing) ===
dist/
.cache/
