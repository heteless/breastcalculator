# --- Security headers & performance hints ---
#
# CSP note: the Skimlinks affiliate-automation loader was removed from every
# page on 2026-10-18, so its four allowances went with it — *.skimresources.com
# from script-src (the loader), connect-src (link resolution) and frame-src (its
# hidden cross-domain cookie-sync frame), plus sl-sentry.skimlinks.com from
# connect-src (the loader's error reporter, a different registrable domain).
# Re-add all of them if the snippet is ever restored, otherwise the browser
# blocks it silently and no links get rewritten.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # AdSense needs these too; the previous policy blocked them and the browser
  # logged a violation on every page load:
  #   fundingchoicesmessages.google.com  Google's EEA/UK consent message. Blocked
  #     => no consent UI => Google can only serve non-personalised ads to EEA traffic.
  #   goog#html                          AdSense's own Trusted Types policy.
  #   *.adtrafficquality.google          Ad Quality (sodar) config fetch.
  #   fonts.googleapis.com / gstatic     fonts used inside ad creatives.
  #   static.cloudflareinsights.com, analytics.ahrefs.com
  #     both tags already ship in the HTML; blocked, so they cost a request and
  #     collect nothing. Allowed here rather than removed from the pages.
  #
  # Measured on the live site after the 2026-10-18 deploy (browser console, every
  # page load) — these were still being blocked, silently:
  #   https://www.google.com/g/collect   GA4 page_view + scroll events. Blocked =>
  #     Analytics reported almost no traffic even though the tag loaded fine.
  #   https://fundingchoicesmessages.google.com/el/...  consent-message reporting,
  #     blocked in connect-src although script-src already allowed the loader.
  #   https://ep2.adtrafficquality.google/sodar/sodar2.js  Ad Quality script,
  #     allowed to connect but not to load.
  #   TrustedTypePolicy 'ContributorServingResponseClientJs#html'  AdSense's
  #     contributor-annotation policy, separate from goog#html.
  #   https://analytics.ahrefs.com/api/event  same story: script allowed, beacon not.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://fundingchoicesmessages.google.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googlesyndication.com https://*.adtrafficquality.google https://*.google.com https://*.googletagmanager.com https://analytics.ahrefs.com; frame-src https://googleads.g.doubleclick.net https://*.googlesyndication.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests; trusted-types bc bc-domains goog#html ContributorServingResponseClientJs#html 'allow-duplicates'
  Content-Signal: search=yes,ai-train=no
  Vary: Accept-Encoding
  Accept-CH: Sec-CH-Prefers-Color-Scheme, Sec-CH-UA-Mobile, Sec-CH-UA-Platform
  Critical-CH: Sec-CH-Prefers-Color-Scheme
  Cross-Origin-Opener-Policy: same-origin

