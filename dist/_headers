# Cloudflare Pages _headers
# All pages are now directory-based: /path/index.html (served as /path/)
# Cache-Control: max-age in seconds (31536000 = 1 year, 3600 = 1 hour)

# --- Static assets: immutable, long-term cache (1 year) ---

/style.css
  Cache-Control: public, max-age=31536000, immutable
/style.css?v=*
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable
/script.js?v=*
  Cache-Control: public, max-age=31536000, immutable

# --- Favicon & PWA assets: long-term cache (1 year) ---

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-96x96.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-192x192.png
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=604800

# --- Robots & sitemap: medium cache (1 day) ---

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# --- HTML pages: short cache with revalidation (1 hour) ---
# IMPORTANT: stale-while-revalidate used to be 86400, which let Cloudflare's
# edge serve stale HTML for up to 24 h after a deploy — the cause of
# "deployed but still showing the old version" reports. We now use
# `no-cache, must-revalidate` so the browser and the CDN must revalidate
# with the origin on every request. Origin response is static and free,
# so the cost is negligible and content is always fresh.

# === AI Agent Discovery: RFC 8288 Link headers + RFC 9727 ===
# The homepage advertises machine-readable resources to agents and crawlers
# via the standard HTTP Link header. See:
#   https://isitagentready.com/.well-known/agent-skills/link-headers/SKILL.md
#   https://www.rfc-editor.org/rfc/rfc8288
#   https://www.rfc-editor.org/rfc/rfc9727#section-3

/index.html
  Cache-Control: public, no-cache, must-revalidate
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/json", </.well-known/agent-skills/link-headers/SKILL.md>; rel="service-doc"; type="text/markdown", </.well-known/llms.txt>; rel="service-desc"; type="text/plain", </sitemap.xml>; rel="describedby"; type="application/xml", </robots.txt>; rel="describedby"; type="text/plain"

