# Cloudflare Pages _headers
# All pages are now directory-based: /path/index.html (served as /path/)
# Cache-Control: max-age in seconds (31536000 = 1 year, 3600 = 1 hour)

# --- Static assets: immutable, long-term cache (1 year) ---

/style.css
  Cache-Control: public, max-age=31536000, immutable
/style.css?v=*
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable
/script.js?v=*
  Cache-Control: public, max-age=31536000, immutable

# --- Favicon & PWA assets: long-term cache (1 year) ---

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-96x96.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-192x192.png
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=604800

# --- Robots & sitemap: medium cache (1 day) ---

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# --- HTML pages: short cache with revalidation (1 hour) ---
# IMPORTANT: stale-while-revalidate used to be 86400, which let Cloudflare's
# edge serve stale HTML for up to 24 h after a deploy — the cause of
# "deployed but still showing the old version" reports. We now use
# `no-cache, must-revalidate` so the browser and the CDN must revalidate
# with the origin on every request. Origin response is static and free,
# so the cost is negligible and content is always fresh.

/index.html
  Cache-Control: public, no-cache, must-revalidate

/about/index.html
  Cache-Control: public, no-cache, must-revalidate

/articles/index.html
  Cache-Control: public, no-cache, must-revalidate

/privacy/index.html
  Cache-Control: public, no-cache, must-revalidate

/specials/index.html
  Cache-Control: public, no-cache, must-revalidate

/terms/index.html
  Cache-Control: public, no-cache, must-revalidate

/wellness/index.html
  Cache-Control: public, no-cache, must-revalidate

/404.html
  Cache-Control: no-cache

# --- Subdirectory pages: all use the same pattern (index.html in dir) ---

/tools/*/index.html
  Cache-Control: public, no-cache, must-revalidate

/specials/*/index.html
  Cache-Control: public, no-cache, must-revalidate

/wellness/*/index.html
  Cache-Control: public, no-cache, must-revalidate

/article/*/index.html
  Cache-Control: public, no-cache, must-revalidate

/compare/index.html
  Cache-Control: public, no-cache, must-revalidate

/compare/*/index.html
  Cache-Control: public, no-cache, must-revalidate

# --- Next.js generated clusters (SSG output) ---

/bra-size-calculator/index.html
  Cache-Control: public, no-cache, must-revalidate

/bra-size-guide/index.html
  Cache-Control: public, no-cache, must-revalidate

/bra-size-guide/*/index.html
  Cache-Control: public, no-cache, must-revalidate

/bra-buying-guide/index.html
  Cache-Control: public, no-cache, must-revalidate

/best-comfort-bras/index.html
  Cache-Control: public, no-cache, must-revalidate

/best-wireless-bras/index.html
  Cache-Control: public, no-cache, must-revalidate

/how-to-measure-bra-size/index.html
  Cache-Control: public, no-cache, must-revalidate

/sports-bra-guide/index.html
  Cache-Control: public, no-cache, must-revalidate

# --- Next.js hashed bundles: long-term immutable cache (1 year) ---

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# --- Image assets: medium cache (7 days) ---

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# --- Security headers & performance hints ---

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googlesyndication.com; frame-src https://googleads.g.doubleclick.net https://*.googlesyndication.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; trusted-types bc bc-domains 'allow-duplicates'; require-trusted-types-for 'script'
  Vary: Accept-Encoding
  Accept-CH: Sec-CH-Prefers-Color-Scheme, Sec-CH-UA-Mobile, Sec-CH-UA-Platform
  Critical-CH: Sec-CH-Prefers-Color-Scheme
  Cross-Origin-Opener-Policy: same-origin

# iOS / macOS specific MIME and behavior hints
/style.css
  Content-Type: text/css; charset=utf-8
/script.js
  Content-Type: application/javascript; charset=utf-8
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Apple touch icon served with proper MIME
/apple-touch-icon.png
  Content-Type: image/png
/apple-touch-icon-precomposed.png
  Content-Type: image/png
